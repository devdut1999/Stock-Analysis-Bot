# ==============================================================================
# REQUIRED: Claude AI API Key
# ==============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ==============================================================================
# US MARKET DATA APIs (Start with free tiers)
# ==============================================================================

# Alpha Vantage (Free: 25 calls/day, Paid: from $49.99/mo)
# Get free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=demo

# Twelve Data (Free: 800 calls/day, Paid: from $29/mo)
# Get free key at: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=demo

# Polygon.io (Paid: $89/mo for real-time)
# Get key at: https://polygon.io/pricing
# POLYGON_API_KEY=your-polygon-key-here

# Financial Modeling Prep (Free: 250 calls/day, Paid: from $15/mo)
# Get free key at: https://site.financialmodelingprep.com/developer/docs
# FMP_API_KEY=your-fmp-key-here

# ==============================================================================
# INDIAN MARKET DATA APIs
# ==============================================================================

# Free Indian Stock Market API (No key required)
# GitHub: https://github.com/0xramm/Indian-Stock-Market-API
INDIAN_STOCK_API_URL=https://indian-stock-api.vercel.app/api

# TrueData (Paid: ~₹2000/mo for real-time NSE/BSE data)
# Get key at: https://www.truedata.in/
# TRUEDATA_API_KEY=your-truedata-key-here

# ICICI Breeze API (Free with ICICI Direct trading account)
# Docs: https://www.icicidirect.com/futures-and-options/api/breeze
# BREEZE_API_KEY=your-breeze-key-here
# BREEZE_API_SECRET=your-breeze-secret-here
# BREEZE_SESSION_TOKEN=your-session-token-here

# ==============================================================================
# NEWS & SENTIMENT APIs
# ==============================================================================

# NewsAPI (Free: 100 requests/day, Paid: from $449/mo)
# Get free key at: https://newsapi.org/pricing
# NEWS_API_KEY=your-newsapi-key-here

# ==============================================================================
# ALERT & NOTIFICATION SERVICES
# ==============================================================================

# Telegram Bot (Free)
# Create bot: https://t.me/BotFather
# TELEGRAM_BOT_TOKEN=your-bot-token-here
# TELEGRAM_CHAT_ID=your-chat-id-here

# Email SMTP (Use Gmail, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password
# ALERT_EMAIL_TO=recipient@example.com

# ==============================================================================
# TRADING PLATFORM INTEGRATION (Optional - for future)
# ==============================================================================

# Alpaca Trading API (US stocks - Paper & Live trading)
# Get keys at: https://alpaca.markets/
# ALPACA_API_KEY=your-alpaca-key-here
# ALPACA_API_SECRET=your-alpaca-secret-here
# ALPACA_BASE_URL=https://paper-api.alpaca.markets  # Use paper trading URL for testing

# Zerodha Kite API (Indian stocks)
# Get keys at: https://kite.trade/
# ZERODHA_API_KEY=your-zerodha-key-here
# ZERODHA_API_SECRET=your-zerodha-secret-here
# ZERODHA_ACCESS_TOKEN=your-access-token-here

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Logging level
LOG_LEVEL=info

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60

# Signal validation thresholds
MIN_CONSENSUS_PERCENTAGE=60
MAX_POSITION_SIZE_PERCENTAGE=20
MIN_LIQUIDITY_VOLUME_USD=100000
MIN_LIQUIDITY_VOLUME_INR=10000000

# Default mode
DEFAULT_ANALYSIS_MODE=comprehensive
